# ===========================
# Application
# ===========================

PORT=5000
NODE_ENV=development

# ===========================
# Database
# ===========================

# Postgres (Neon) connection string, e.g.
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Admin/migration connection (owns tables, runs Prisma migrate/db push + RLS scripts).
DATABASE_URL=

# Runtime application connection: least-privilege role (no BYPASSRLS), subject to
# Row-Level Security (M9 Phase 3). If unset, the app falls back to DATABASE_URL.
# Migrations/DDL always use DATABASE_URL, never this.
APP_DATABASE_URL=

# ===========================
# Authentication
# ===========================

# --- Access / Refresh tokens (Milestone 8, blueprint §13.1) ---
# Separate strong (256-bit+) secrets. In production set these ONLY in the
# platform secret manager — never commit real values.
JWT_ACCESS_SECRET=change_me_to_a_long_random_access_secret
JWT_REFRESH_SECRET=change_me_to_a_long_random_refresh_secret

# Token lifetimes (blueprint defaults: 15 minutes / 7 days).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Refresh-token cookie. Secure requires HTTPS, so leave it unset to default OFF
# in development and ON in production. SameSite: strict | lax | none.
REFRESH_COOKIE_NAME=memovix_refresh
REFRESH_COOKIE_PATH=/api/auth
COOKIE_SAMESITE=strict
COOKIE_SECURE=

# ===========================
# File Storage (AWS S3)
# ===========================

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# ===========================
# AI Provider
# ===========================

# Legacy fallback used when the two specific providers below are omitted.
AI_PROVIDER=ollama

# groq for generation; gemini for hosted free-tier embeddings
CHAT_PROVIDER=groq
EMBEDDING_PROVIDER=gemini

# Ollama (self-hosted, zero-cost)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b

# OpenAI (hosted alternative)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Groq (hosted chat/generation; Free Plan is rate-limited)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=low

# Gemini (hosted embeddings; 768 dimensions match the existing pgvector schema)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# ===========================
# Email (transactional)
# ===========================

EMAIL_PROVIDER=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ===========================
# URLs
# ===========================

APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ===========================
# Rate Limiting (Milestone 1)
# ===========================

# Master switch. Defaults to OFF in development and ON in production when unset.
# Set to "true" locally only if you want to exercise the limits.
RATE_LIMIT_ENABLED=

# Auth endpoints (login / register / password-reset) — keyed by IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# AI endpoints (/api/ai/*) — keyed by user, falls back to IP.
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30

# File upload — keyed by user, falls back to IP.
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=30

# Baseline for all routes — keyed by user, falls back to IP.
GENERAL_RATE_LIMIT_WINDOW_MS=60000
GENERAL_RATE_LIMIT_MAX=300

# --- Structured Requirements (Milestone 6) ---
# Allowed values for a requirement's `category` (blueprint §6.2.8), comma-
# separated. Kept as config (not a Prisma enum) so categories can change with no
# migration. Leave unset to use the default: design,content,technical,other.
REQUIREMENT_CATEGORIES=

# --- Scope Creep Detection (Milestone 7) ---
# Cosine-similarity cutoff for the deterministic pre-filter (blueprint §8.10):
# a new requirement whose similarity to a baseline item is >= this is treated as
# "already covered" and skips the LLM classification call. Tune against real
# data (§11.7). Leave unset to use the default: 0.92.
SCOPE_SIMILARITY_THRESHOLD=
